# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5500

# --- Database (must have the pgvector extension available) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/askyourdocs

# --- Embeddings: "local" (sentence-transformers, free, offline) or "openai" ---
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384
# If you switch EMBEDDING_PROVIDER to openai, also set:
# EMBEDDING_DIMENSION=1536
# OPENAI_API_KEY=sk-...

# --- LLM used to generate answers: "openai" or "anthropic" ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest

# --- Ingestion ---
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
MAX_UPLOAD_SIZE_MB=20

# --- Retrieval ---
RETRIEVAL_TOP_K=5
MIN_RELEVANCE_SCORE=0.25

# --- Cache & rate limiting ---
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=256
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
