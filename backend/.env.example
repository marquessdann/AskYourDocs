# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5500

# --- Database (must have the pgvector extension available) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/askyourdocs

# --- Embeddings: "local", "openai", or "google" ---
# "local" (sentence-transformers) needs `pip install -r requirements-local-embeddings.txt`
# (pulls in PyTorch, ~1GB+) and 512MB+ of free RAM at runtime — fine on your own
# machine, but too heavy for small free-tier hosts (e.g. Render's free plan gets
# OOM-killed). "openai" is paid (no reliable free credits as of 2026). "google" uses
# the Gemini API's free tier — no credit card required — and is the best default for
# a free deploy: get a key at https://aistudio.google.com/apikey
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384
# If you switch EMBEDDING_PROVIDER to openai, also set:
# EMBEDDING_DIMENSION=1536
# OPENAI_API_KEY=sk-...
# If you switch EMBEDDING_PROVIDER to google, also set:
# EMBEDDING_DIMENSION=768
# GOOGLE_API_KEY=...

# --- LLM used to generate answers: "openai", "anthropic", or "google" ---
# "google" reuses the same GOOGLE_API_KEY as the embeddings above — free, no card.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest
GOOGLE_CHAT_MODEL=gemini-flash-latest

# --- Ingestion ---
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
MAX_UPLOAD_SIZE_MB=20

# --- Retrieval ---
RETRIEVAL_TOP_K=5
MIN_RELEVANCE_SCORE=0.25

# --- Cache & rate limiting ---
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=256
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
